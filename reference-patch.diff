diff --git a/src/GPSTracker.Grains/GeoMath.cs b/src/GPSTracker.Grains/GeoMath.cs
index 67c5f22..fecfae2 100644
--- a/src/GPSTracker.Grains/GeoMath.cs
+++ b/src/GPSTracker.Grains/GeoMath.cs
@@ -7,8 +7,20 @@ public static class GeoMath
     public static double DistanceMetres(DeviceMessage first, DeviceMessage second)
     {
         const double EarthRadiusMetres = 6_371_008.8;
-        var x = (second.Longitude - first.Longitude) * Math.Cos((second.Latitude + first.Latitude) / 2);
-        var y = second.Latitude - first.Latitude;
-        return Math.Sqrt((x * x) + (y * y)) * EarthRadiusMetres;
+        var firstLatitude = ToRadians(first.Latitude);
+        var secondLatitude = ToRadians(second.Latitude);
+        var latitudeDelta = secondLatitude - firstLatitude;
+        var longitudeDelta = Math.IEEERemainder(
+            ToRadians(second.Longitude - first.Longitude),
+            2 * Math.PI);
+        var sinLatitude = Math.Sin(latitudeDelta / 2);
+        var sinLongitude = Math.Sin(longitudeDelta / 2);
+        var haversine =
+            (sinLatitude * sinLatitude) +
+            (Math.Cos(firstLatitude) * Math.Cos(secondLatitude) * sinLongitude * sinLongitude);
+        haversine = Math.Clamp(haversine, 0, 1);
+        return 2 * EarthRadiusMetres * Math.Atan2(Math.Sqrt(haversine), Math.Sqrt(1 - haversine));
     }
+
+    private static double ToRadians(double degrees) => degrees * Math.PI / 180;
 }

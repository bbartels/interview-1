+
+    private void Validate(DeviceMessage message)
+    {
+        if (message.DeviceId != this.GetPrimaryKeyLong())
+        {
+            throw new ArgumentException("Device ID does not match the grain key.", nameof(message));
+        }
+
+        if (message.UpdateId.Epoch < 0 || message.UpdateId.Sequence <= 0)
